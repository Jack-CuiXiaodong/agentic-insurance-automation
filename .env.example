# Copy to .env and fill in as needed. Everything has a safe default; the demo
# runs with NO values set at all (deterministic LLM + mock insurance backend).

# --- LLM -----------------------------------------------------------------
# auto (default): Anthropic wins if ANTHROPIC_API_KEY is set, else an
# OpenAI-compatible provider wins if LLM_API_KEY is set, else deterministic.
# Force one explicitly with: anthropic | openai_compatible | deterministic
LLM_MODE=auto

# Option A -- Anthropic Claude (often unreachable from mainland China networks)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Option B -- any OpenAI-wire-compatible provider (recommended for a China
# deployment). One backend, swapped by provider preset:
#
#   LLM_PROVIDER=deepseek   -> https://api-docs.deepseek.com/quick_start/pricing/
#                              cheapest verified option with tool calling; default.
#   LLM_PROVIDER=qwen       -> https://bailian.console.aliyun.com/ (Alibaba Cloud)
#   LLM_PROVIDER=kimi       -> https://platform.kimi.com/docs/pricing/chat (Moonshot)
#   LLM_PROVIDER=zhipu      -> https://open.bigmodel.cn/pricing (GLM)
#   LLM_PROVIDER=custom     -> set LLM_BASE_URL + LLM_MODEL yourself
#
# Model ids and prices in these presets move fast -- confirm against the docs
# link above before you rely on them for anything but this demo.
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Optional overrides (leave blank to use the preset's default):
LLM_MODEL=
LLM_BASE_URL=

# --- Insurance backend -------------------------------------------------------
# mock (default, offline) | core (a carrier's own system, requires CORE_API_KEY)
INSURANCE_PROVIDER=mock
CORE_API_BASE_URL=http://127.0.0.1:8080
CORE_API_KEY=

# --- Legacy web app (RPA / recovery demo) ------------------------------------
LEGACY_HOST=127.0.0.1
LEGACY_PORT=5001

# --- RPA 执行后端 -------------------------------------------------------------
# mock（默认）  本地模拟查验平台 + 一个写死的选择器。不需要任何 RPA 产品，
#               零配置即可跑完整个 demo。
# shadowbot     影刀（ShadowBot）。编排层通过影刀自带的命令行触发一个已发布的
#               影刀应用，见 rpa/shadowbot.py 与 .claude/skills/shadowbot-cli/。
#               需要本机装好影刀客户端并已登录——适配器不代为登录，也不持有凭据。
RPA_PROVIDER=mock

# 影刀 CLI 的绝对路径。留空 = 按平台在 PATH 上找
# （Windows: shadowbot.shell-cli.exe / macOS 与信创: shadowbot-cli）。
SHADOWBOT_CLI=
# 要触发的影刀应用 ID。用 `console app` 查出来填这里，没有默认值。
SHADOWBOT_APP_ID=
# 传业务入参用的 flag。影刀官方文档要求现场 `console task run --help` 确认写法，
# 所以这里不给默认值：留空 = 不传入参；填上（例如 --params）= 把报案字段拼成
# 一个 JSON 参数追加在后面。
SHADOWBOT_INPUT_FLAG=
# 单次任务的最长等待秒数，以及轮询间隔。
SHADOWBOT_TIMEOUT=300
SHADOWBOT_POLL_INTERVAL=2

# --- Browser -----------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
# Optional: use a Chromium/Chrome binary already present on the machine instead
# of the build Playwright downloads. Handy in sandboxes / CI images that ship a
# browser whose build number differs from the installed Playwright.
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium
